# Copy to .env and fill in. Never commit .env.

# Django core settings
DJANGO_DEBUG=True
# Use a long random string (50+ characters). Short keys weaken the login tokens.
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2,backend

# CORS (allows the React web dashboard and the React Native / Expo app)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# PostgreSQL (also used by the db container in docker-compose.yml)
POSTGRES_DB=vri_uganda_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# "db" when running with Docker; "localhost" when running Django directly on your machine
DATABASE_HOST=db
DATABASE_PORT=5432

# Hosted database (Neon/Render). When set it replaces the POSTGRES_* settings above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Email for account recovery codes. Leave unset in development: emails are printed in the
# backend logs (docker compose logs -f backend). Production example:
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# DEFAULT_FROM_EMAIL=SignConnect <no-reply@your-domain>

# Production only:
# NUM_PROXIES=1                      # number of proxies (nginx/load balancer) in front of Django
# CACHE_URL=redis://redis:6379/1     # shared cache so rate limits work across server processes

# Expo push notifications
EXPO_PUSH_ENABLED=false
# Optional Expo push service access token; never commit real credentials.
EXPO_ACCESS_TOKEN=