# Copy to .env and fill in. Never commit .env.

# Django core settings
DJANGO_DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2,backend

# CORS (allows the React web dashboard and the React Native / Expo app)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# PostgreSQL (also used by the db container in docker-compose.yml)
POSTGRES_DB=vri_uganda_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# "db" when running with Docker; "localhost" when running Django directly on your machine
DATABASE_HOST=db
DATABASE_PORT=5432
